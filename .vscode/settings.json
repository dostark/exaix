{
  "files.eol": "\n",
  "editor.tabSize": 2,
  "editor.formatOnSave": true,
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "deno.enable": true,
  "deno.lint": true,
  "deno.suggest.imports.autoDiscover": true,
  "deno.suggest.imports.hosts": {
    "https://deno.land": true
  },
  "deno.documentPreloadLimit": 0,
  // "js/ts.validate.enabled": false,
  // "js/ts.tsserver.experimental.enableProjectDiagnostics": false,
  "json.schemaDownload.enable": true,
  "json.schemas": [
    {
      "fileMatch": [
        "**/deno.json"
      ],
      "url": "./schemas/deno-config.schema.json"
    }
  ],
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/node_modules/**": true,
    "**/coverage/**": true,
    "**/.deno/**": true,
    "**/target/**": true
  },
  "[typescript]": {
    "editor.defaultFormatter": "denoland.vscode-deno",
    "editor.formatOnSave": true
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "denoland.vscode-deno",
    "editor.formatOnSave": true
  },
  "chat.tools.terminal.autoApprove": {
    "timeout": true,
    "git checkout": true,
    "true": true,
    "tee": true
  }
}
