{
  "version": 2,
  "plugin": "exaix",
  "docsBase": "unslop-ts/docs/style_guide.md",
  "paths": {
    "test": [
      "**/tests/**",
      "**/*_test.ts",
      "**/*_test.tsx",
      "**/*.test.ts"
    ],
    "fixture": [
      "tests/scenario_framework/fixtures/**",
      "**/tests/fixtures/**"
    ],
    "ignore": [
      {
        "glob": "**/unslop-ts/**",
        "reason": "Engine repository, linted by its own CI."
      },
      {
        "glob": "**/.git/**",
        "reason": "Version-control metadata."
      },
      {
        "glob": "**/node_modules/**",
        "reason": "Installed dependencies."
      },
      {
        "glob": "**/check_code_style.ts",
        "reason": "Self-exemption: the checker's own rule regexes and messages trip its rules."
      },
      {
        "glob": "**/check_code_style_rules_test.ts",
        "reason": "Rule-case snippets are intentional violation shapes for the rule-level tests."
      },
      {
        "glob": "**/scenario_framework/fixtures/**",
        "reason": "Fixture scope: fixtures intentionally contain violation shapes."
      },
      {
        "glob": "**/dist/**",
        "reason": "Build output."
      },
      {
        "glob": "**/coverage/**",
        "reason": "Coverage output."
      },
      {
        "glob": "**/.copilot/**",
        "reason": "Agent guidance, not production code."
      }
    ]
  },
  "tags": {
    "magic-values": {
      "description": "No magic numbers or strings (docs/CODE_STYLE.md#no-magic-values)."
    },
    "duplication": {
      "description": "Rules that find restated or duplicated declarations"
    },
    "deslop": {
      "description": "Rule idea taken from maharshi365/deslop or dmmulroy/anti-slop."
    },
    "type-safety": {
      "description": "Rules that keep type evidence (unslop-ts/docs/style_guide.md#strict-type-safety)."
    },
    "complexity": {
      "description": "Function and method size limits (unslop-ts/docs/style_guide.md#complexity-rules)."
    },
    "module-structure": {
      "description": "Module headers and placement (docs/CODE_STYLE.md#module-structure)."
    },
    "test-quality": {
      "description": "Rules on test code and fixtures."
    },
    "imports": {
      "description": "Import shape and placement rules (docs/CODE_STYLE.md#import-statements)."
    },
    "boundary": {
      "description": "Cross-boundary import rules."
    },
    "tui": {
      "description": "TUI isolation boundary (docs/CODE_STYLE.md#tui-boundaries)."
    },
    "cli": {
      "description": "CLI isolation boundary (docs/CODE_STYLE.md#cli-boundaries)."
    },
    "package": {
      "description": "Package structure and purity."
    },
    "di": {
      "description": "Dependency injection and interfaces (docs/CODE_STYLE.md#di-and-interfaces)."
    },
    "comments": {
      "description": "Comment discipline (docs/CODE_STYLE.md#comment-discipline)."
    },
    "edition": {
      "description": "Edition tier import boundary."
    },
    "scripts": {
      "description": "Utility script headers (docs/CODE_STYLE.md#utility-scripts)."
    }
  },
  "rules": {
    "duplicate-constant": {
      "level": "error",
      "options": {
        "namePattern": "^[A-Z][A-Z0-9_]*$",
        "allow": [
          {
            "name": "GIT_CMD_STATUS",
            "files": [
              "packages/execution/src/strategies/cli_delegate_strategy.ts",
              "packages/git/src/constants.ts"
            ],
            "reason": "The git package does not export its low-level subcommand strings, so the execution seam keeps its own."
          },
          {
            "name": "REVIEWS_TABLE_SQL",
            "files": [
              "packages/git/testing/helpers/db.ts",
              "packages/testing/src/helpers/init_db.ts"
            ],
            "reason": "The git test helpers keep their own schema text rather than depend on the shared testing package."
          },
          {
            "name": "TEST_DEFAULT_BRANCH",
            "files": [
              "packages/git/testing/helpers/constants.ts",
              "packages/testing/src/helpers/constants.ts"
            ],
            "reason": "The git test helpers keep their own branch default rather than depend on the shared testing package."
          },
          {
            "name": "GIT_FLAG_UNTRACKED_FILES_ALL",
            "files": [
              "packages/execution/src/strategies/cli_delegate_strategy.ts",
              "packages/git/src/constants.ts"
            ],
            "reason": "The git package does not export its low-level subcommand flags, so the execution seam keeps its own."
          }
        ]
      },
      "scope": "prod",
      "include": [
        "packages/**",
        "apps/**"
      ],
      "limits": "Compares top-level named constants with a static value; values from a call, identifier, or interpolation are out of scope.",
      "tags": [
        "magic-values",
        "duplication",
        "deslop"
      ]
    },
    "duplicate-type": {
      "level": "error",
      "options": {
        "minProperties": 2,
        "allow": [
          {
            "name": "IOpenAIEmbeddingConfig",
            "files": [
              "packages/ai/src/providers/openai_embedding_client.ts",
              "packages/ai-openai/src/openai_embedding_client.ts"
            ],
            "reason": "The ai copy exists to avoid a circular dependency between @exaix/ai and @exaix/ai-openai."
          },
          {
            "name": "IValidationError",
            "files": [
              "packages/quality-gate/src/internal_types.ts",
              "packages/tool-runtime/src/output_validator.ts"
            ],
            "reason": "The two packages have no dependency edge and validate independent shapes."
          },
          {
            "name": "ICliDelegateProcessResult",
            "files": [
              "packages/ai-clidelegate/src/cli_delegate_model_provider.ts",
              "packages/execution/src/strategies/cli_delegate_strategy.ts"
            ],
            "reason": "The two packages have no dependency edge and each owns its subprocess seam."
          },
          {
            "name": "IToolResult",
            "files": [
              "packages/core/src/types/i_tool_reflector.ts",
              "packages/tool-runtime/src/tool_reflector.ts"
            ],
            "reason": "Core exports a second IToolResult from i_tool_registry, so the reflector copy is not reachable through the core barrel."
          }
        ]
      },
      "scope": "prod",
      "include": [
        "packages/**",
        "apps/**"
      ],
      "limits": "Compares interface and object type alias members after whitespace normalization. Imported aliases are not resolved.",
      "tags": [
        "duplication",
        "deslop"
      ]
    },
    "exaix/ignore-needs-reason": {
      "level": "error",
      "options": {
        "separator": "--"
      },
      "limits": "Only ignores that name an exaix rule are checked.",
      "tags": [
        "type-safety",
        "deslop"
      ]
    },
    "exaix/require-optional-wrapper": {
      "level": "off",
      "options": {
        "wrapperType": "Opt"
      },
      "optIn": true,
      "reason": "Opt-in: the bare-optional check is a staged-file ratchet today, not a full-tree gate.",
      "docs": "docs/CODE_STYLE.md#optional-params",
      "limits": "Only function and method parameters are checked.",
      "tags": [
        "type-safety",
        "deslop"
      ]
    },
    "exaix/max-cyclomatic-complexity": {
      "level": "error",
      "options": {
        "max": 15
      },
      "scope": "prod",
      "include": [
        "packages/*/src/**",
        "apps/*/src/**"
      ],
      "limits": "A SwitchCase counts only with a test, and a LogicalExpression only for '||' and '&&'. Nested function bodies are excluded.",
      "tags": [
        "complexity",
        "deslop"
      ]
    },
    "exaix/max-class-size": {
      "level": "off",
      "options": {
        "minClassLines": 200,
        "threshold": 60
      },
      "optIn": true,
      "reason": "Manual today: check:god-objects is a separate manual task, so the rule runs only when selected.",
      "limits": "Score is per class; a class under minClassLines is skipped before scoring.",
      "tags": [
        "complexity",
        "module-structure"
      ]
    },
    "exaix/no-repeated-assert-call": {
      "level": "off",
      "options": {
        "assertPrefix": "assert"
      },
      "scope": "test",
      "optIn": true,
      "reason": "Enforced by the rule-ceiling ratchet (packages/lint-policy/rule_ceilings.json).",
      "tags": [
        "test-quality",
        "deslop"
      ]
    },
    "exaix/no-constant-substring-assert": {
      "level": "off",
      "options": {
        "constantPattern": "^[A-Z][A-Z0-9_]*$"
      },
      "scope": "test",
      "optIn": true,
      "reason": "Enforced by the rule-ceiling ratchet (packages/lint-policy/rule_ceilings.json).",
      "tags": [
        "test-quality",
        "deslop"
      ]
    },
    "exaix/no-boolean-assert": {
      "level": "off",
      "options": {
        "methods": [
          "includes",
          "startsWith",
          "endsWith"
        ],
        "assertFunctions": [
          "assert",
          "assertEquals",
          "assertStrictEquals"
        ]
      },
      "scope": "test",
      "optIn": true,
      "reason": "Enforced by the rule-ceiling ratchet (packages/lint-policy/rule_ceilings.json).",
      "tags": [
        "test-quality",
        "deslop"
      ]
    },
    "exaix/require-safety-comment": {
      "level": "off",
      "options": {
        "markers": [
          "SAFETY"
        ]
      },
      "scope": "prod",
      "optIn": true,
      "reason": "Enforced by the rule-ceiling ratchet (packages/lint-policy/rule_ceilings.json).",
      "tags": [
        "type-safety",
        "deslop"
      ]
    },
    "exaix/no-runtime-typeof": {
      "level": "off",
      "options": {
        "allowInTypeGuards": true
      },
      "scope": "prod",
      "optIn": true,
      "reason": "Enforced by the rule-ceiling ratchet (packages/lint-policy/rule_ceilings.json).",
      "limits": "An existence probe against \"undefined\" is allowed.",
      "tags": [
        "type-safety",
        "deslop"
      ]
    },
    "exaix/no-conditional-empty-object-spread": {
      "level": "off",
      "scope": "prod",
      "optIn": true,
      "reason": "Enforced by the rule-ceiling ratchet (packages/lint-policy/rule_ceilings.json).",
      "tags": [
        "type-safety",
        "deslop"
      ]
    },
    "exaix/no-explicit-unknown": {
      "level": "off",
      "options": {
        "allowCatchBinding": true,
        "allowTypePredicateSubject": true
      },
      "optIn": true,
      "reason": "Enforced by the rule-ceiling ratchet (packages/lint-policy/rule_ceilings.json).",
      "tags": [
        "type-safety",
        "deslop"
      ]
    },
    "exaix/no-unsafe-dictionary": {
      "level": "off",
      "options": {
        "forbiddenValueTypes": [
          "unknown",
          "any",
          "object",
          "{}"
        ]
      },
      "optIn": true,
      "reason": "Enforced by the rule-ceiling ratchet (packages/lint-policy/rule_ceilings.json).",
      "limits": "Local aliases and union members are resolved. Wrapper types, intersections, interfaces, mapped-type signatures, and generic alias expansion are not followed. Map<K, V> is checked; a generic constraint is allowed.",
      "tags": [
        "type-safety",
        "deslop"
      ]
    },
    "exaix/no-typeof-escape": {
      "level": "off",
      "options": {
        "allowedTypeofTargets": [
          "globalThis.fetch"
        ]
      },
      "optIn": true,
      "reason": "Enforced by the rule-ceiling ratchet (packages/lint-policy/rule_ceilings.json).",
      "limits": "Only an as typeof cast is reported; the built-in no-explicit-any reports any. The typeof target is compared as source text, and only test files may use an allowed target.",
      "tags": [
        "type-safety",
        "deslop"
      ]
    },
    "exaix/no-pass-through-type-alias": {
      "level": "error",
      "reason": "Deferred: the codebase-wide type cleanup is tracked in the Step 6 Reachability Ledger.",
      "tags": [
        "type-safety",
        "deslop"
      ]
    },
    "exaix/no-object-parameters": {
      "level": "off",
      "optIn": true,
      "reason": "Enforced by the rule-ceiling ratchet (packages/lint-policy/rule_ceilings.json).",
      "limits": "Only a direct object annotation is checked. A parameter with a default value, and a local alias of object, are not resolved.",
      "tags": [
        "type-safety",
        "deslop"
      ]
    },
    "exaix/promise-response-alias": {
      "level": "error"
    },
    "exaix/promise-response-return": {
      "level": "off",
      "optIn": true,
      "reason": "Parked: The AST rule also reports a parameter, a variable, and a function type that the line scanner missed. Phase 230 burns them down and turns the rule on."
    },
    "exaix/ts-suppression-pragmas": {
      "level": "error"
    },
    "exaix/no-forbidden-lint-ignore": {
      "level": "error",
      "options": {
        "includeFileIgnores": false
      }
    },
    "exaix/import-inside-statement": {
      "level": "error",
      "options": {
        "allowDynamicImports": [
          {
            "files": [
              "apps/daemon/**",
              "apps/exactl/**",
              "exaix-team/apps/daemon/**",
              "exaix-team/apps/exactl/**"
            ],
            "specifiers": [
              "^@exaix-team/",
              "^\\./src/bootstrap_team"
            ]
          },
          {
            "files": [
              "**/unslop-ts/src/cli/project_loader.ts",
              "src/cli/project_loader.ts"
            ],
            "specifiers": []
          }
        ]
      },
      "docs": "unslop-ts/docs/style_guide.md#dynamic-imports"
    },
    "exaix/dynamic-import": {
      "level": "error",
      "options": {
        "allowDynamicImports": [
          {
            "files": [
              "apps/daemon/**",
              "apps/exactl/**",
              "exaix-team/apps/daemon/**",
              "exaix-team/apps/exactl/**"
            ],
            "specifiers": [
              "^@exaix-team/",
              "^\\./src/bootstrap_team"
            ]
          },
          {
            "files": [
              "**/unslop-ts/src/cli/project_loader.ts",
              "src/cli/project_loader.ts"
            ],
            "specifiers": []
          },
          {
            "files": [
              "**/unslop-ts/src/cli/project_loader.ts",
              "src/cli/project_loader.ts"
            ],
            "specifiers": []
          }
        ]
      }
    },
    "exaix/inline-type-import": {
      "level": "error"
    },
    "exaix/re-export-imported": {
      "level": "off",
      "exclude": [
        "**/mod.ts",
        "**/index.ts",
        "src/services/core/db.ts",
        "tests/helpers/**",
        "packages/*/tests/helpers/**"
      ],
      "optIn": true,
      "reason": "Entrypoints and the compatibility shim legitimately re-export; the code keeps the isTestingCompatibilityShim call. Parked: the AST rule finds violations that the former line scanner missed. Phase 230 burns them down and turns the rule on."
    },
    "exaix/import-boundaries": {
      "level": "error",
      "options": {
        "zones": [
          {
            "id": "tui-boundary-cli",
            "files": [
              "**/apps/tui/src/**",
              "**/apps/tui/tests/**"
            ],
            "deny": [
              {
                "specifier": "^(\\.\\.\\/)+cli\\/",
                "message": "TUI modules must not import from 'apps/exactl/src/'."
              }
            ]
          },
          {
            "id": "tui-boundary-services",
            "files": [
              "**/apps/tui/src/**",
              "**/apps/tui/tests/**"
            ],
            "deny": [
              {
                "specifier": "^(\\.\\.\\/)+services\\/(?!adapters\\/|tui_service_factory\\.ts)",
                "message": "TUI modules must not import from retired 'src/services/' (now 'packages/core/src/services/')."
              }
            ]
          },
          {
            "id": "tui-boundary-config",
            "files": [
              "**/apps/tui/src/**",
              "**/apps/tui/tests/**"
            ],
            "deny": [
              {
                "specifier": "^(\\.\\.\\/)+config\\/",
                "message": "TUI modules must not import from retired 'src/config/' (now 'packages/core/src/config/')."
              }
            ]
          },
          {
            "id": "tui-boundary-helpers",
            "files": [
              "**/apps/tui/src/**"
            ],
            "deny": [
              {
                "specifier": "^(\\.\\.\\/)+helpers\\/",
                "outside": [
                  "**/apps/tui/src/**"
                ],
                "message": "TUI modules must not import from retired 'src/helpers/' (now 'packages/tui/src/helpers/')."
              }
            ]
          },
          {
            "id": "tui-boundary-helpers-tests",
            "files": [
              "**/apps/tui/tests/**"
            ],
            "deny": [
              {
                "specifier": "^(\\.\\.\\/)+helpers\\/",
                "outside": [
                  "**/apps/tui/tests/**"
                ],
                "message": "TUI modules must not import from retired 'src/helpers/' (now 'packages/tui/src/helpers/')."
              }
            ]
          },
          {
            "id": "core-boundary-tui-helpers",
            "files": [
              "**"
            ],
            "except": [
              "**/apps/tui/src/**",
              "**/apps/tui/tests/**",
              "**/tests/tui/**",
              "**/packages/tui/tests/**"
            ],
            "deny": [
              {
                "specifier": "^(\\.\\.\\/)+.*?tui\\/helpers\\/",
                "message": "Non-TUI modules must not import from 'apps/tui/src/helpers/'."
              }
            ]
          },
          {
            "id": "cli-boundary-services",
            "files": [
              "**/apps/exactl/src/commands/**",
              "**/apps/exactl/src/handlers/**",
              "**/apps/exactl/src/command_builders/**"
            ],
            "deny": [
              {
                "specifier": "^(\\.\\.\\/)+services\\/(?!adapters\\/)",
                "message": "CLI command/handler/formatter/builder modules must not import from retired 'src/services/' (now 'packages/core/src/services/') except retired 'src/services/adapters/' (now 'packages/core/src/services/adapters/')."
              }
            ]
          },
          {
            "id": "cli-boundary-config",
            "files": [
              "**/apps/exactl/src/commands/**",
              "**/apps/exactl/src/handlers/**",
              "**/apps/exactl/src/command_builders/**"
            ],
            "deny": [
              {
                "specifier": "^(\\.\\.\\/)+config\\/service(\\.ts)?$",
                "message": "CLI command/handler/formatter/builder modules must not import from retired 'src/config/service.ts' (now 'packages/core/src/config/service.ts')."
              }
            ]
          },
          {
            "id": "core-boundary-cli-helpers",
            "files": [
              "**"
            ],
            "except": [
              "**/apps/exactl/src/**"
            ],
            "deny": [
              {
                "specifier": "apps\\/exactl\\/src\\/helpers\\/",
                "message": "Non-CLI modules must not import from 'apps/exactl/src/helpers/'."
              }
            ]
          },
          {
            "id": "package-src-boundary",
            "files": [
              "packages/**"
            ],
            "except": [
              "**/tests/**",
              "**/*_test.ts",
              "**/*_test.tsx",
              "**/*.test.ts"
            ],
            "deny": [
              {
                "target": [
                  "src/services/core/db.ts",
                  "src/services/tool/tool_validation_reporter.ts",
                  "src/services/tool/cli_confirmation_interceptor.ts",
                  "src/services/tool/notification_queue_confirmation_interceptor.ts",
                  "src/services/tool/output_validator.ts",
                  "src/services/tool/tool_reflector.ts",
                  "src/services/tool/tool_registry.ts",
                  "src/services/utils/json_repair.ts"
                ],
                "message": "Package-owned modules must not import retired root implementation paths like '{target}'. Use the package-owned source of truth instead."
              }
            ]
          },
          {
            "id": "package-tests-boundary",
            "files": [
              "packages/**",
              "exaix-team/**",
              "apps/**"
            ],
            "except": [
              "**/tests/**",
              "**/*_test.ts",
              "**/*_test.tsx",
              "**/*.test.ts",
              "packages/testing/**",
              "**/testing/**"
            ],
            "deny": [
              {
                "target": [
                  "tests",
                  "tests/**"
                ],
                "message": "Functional deployable module must not import from the tests/ folder: '{specifier}'. Move shared code into a package under packages/ (test code is excluded from a deployed workspace)."
              }
            ]
          },
          {
            "id": "package-entrypoint-root-src-reexport",
            "files": [
              "packages/**/mod.ts",
              "packages/**/index.ts"
            ],
            "deny": [
              {
                "specifier": "^(src\\/|(\\.\\.\\/)+src\\/)",
                "message": "Package entrypoints must not re-export entities directly from repo retired 'src/*' paths. Use package-local public exports instead."
              }
            ]
          }
        ]
      },
      "tags": [
        "boundary",
        "tui",
        "cli",
        "package",
        "imports"
      ]
    },
    "exaix/no-interface-rename-on-import": {
      "level": "off",
      "options": {
        "prefix": "I"
      },
      "exclude": [
        "packages/core/src/parsing/markdown.ts"
      ],
      "optIn": true,
      "reason": "Parked: the AST rule reads specifiers on their own lines, which the line scanner skipped. Phase 230 burns them down and turns the rule on.",
      "tags": [
        "imports",
        "di"
      ]
    },
    "exaix/import-placement": {
      "level": "off",
      "optIn": true,
      "reason": "Parked: the AST rule finds violations that the former line scanner missed. Phase 230 burns them down and turns the rule on.",
      "tags": [
        "imports",
        "module-structure"
      ]
    },
    "exaix/magic-union-type": {
      "level": "off",
      "options": {
        "hint": "Define an enum in packages/core/src/types/enums.ts or use a shared named union type."
      },
      "scope": "prod",
      "optIn": true,
      "reason": "Parked: The AST rule exempts only a union that is the whole alias body, so it finds inline unions that the line scanner skipped. Phase 230 burns them down and turns the rule on."
    },
    "exaix/require-module-header": {
      "level": "error"
    },
    "module-header-tag": {
      "level": "error"
    },
    "exaix/exported-interface-naming": {
      "level": "error",
      "options": {
        "prefix": "I"
      },
      "tags": [
        "di"
      ]
    },
    "exaix/exported-interface-placement": {
      "level": "off",
      "optIn": true,
      "reason": "Parked: the AST rule finds violations that the former line scanner missed. Phase 230 burns them down and turns the rule on.",
      "tags": [
        "di",
        "module-structure"
      ]
    },
    "exaix/max-params": {
      "level": "off",
      "options": {
        "max": 7
      },
      "optIn": true,
      "reason": "Parked: the AST rule counts arrows and methods that the line scanner skipped. Phase 230 burns them down and turns the rule on.",
      "tags": [
        "complexity",
        "module-structure"
      ]
    },
    "exaix/long-comment": {
      "level": "off",
      "options": {
        "maxLines": 3
      },
      "optIn": true,
      "reason": "Parked: one comment in scripts/ is over the limit. Phase 230 shortens it and turns the rule on."
    },
    "exaix/ephemeral-comment": {
      "level": "off",
      "options": {
        "phrases": [
          {
            "pattern": "\\bphase\\s+\\d+\\b",
            "flags": "i",
            "hint": "a phase number"
          },
          {
            "pattern": "\\bstep\\s+\\d+\\b",
            "flags": "i",
            "hint": "a step number"
          },
          {
            "pattern": "\\bgaps?\\s*[-#:]\\s*[\\w\\d.-]+",
            "flags": "i",
            "hint": "a GAP identifier"
          },
          {
            "pattern": "\\bgaps?\\s+\\d+\\b",
            "flags": "i",
            "hint": "a GAP identifier"
          },
          {
            "pattern": "\\b(?:pre|post)[ -]?gap\\b",
            "flags": "i",
            "hint": "a pre/post-gap reference"
          },
          {
            "pattern": "\\bgap\\s+(?:analysis|remediation|finding|decision)\\b",
            "flags": "i",
            "hint": "gap analysis/remediation details"
          },
          {
            "pattern": "\\btried\\b",
            "flags": "i",
            "hint": "a narration of a prior attempt"
          },
          {
            "pattern": "\\b(?:didn't|did not)\\s+work\\b",
            "flags": "i",
            "hint": "what didn't work"
          },
          {
            "pattern": "§",
            "flags": "",
            "hint": "a document-section reference (§)"
          }
        ]
      },
      "optIn": true,
      "reason": "Parked: one test helper comment names a phase. Phase 230 rewrites it and turns the rule on."
    },
    "exaix/ephemeral-filename": {
      "level": "error",
      "scope": "test"
    },
    "exaix/decorative-comment": {
      "level": "error"
    },
