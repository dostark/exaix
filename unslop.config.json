    "magic-literals": {
      "level": "error",
      "options": {
        "checkNumbers": true,
        "thresholds": {
          "localString": 3,
          "globalString": 5,
          "localNumber": 4,
          "globalNumber": 6
        },
        "additionalStrings": [
          "other"
        ],
        "minStringLength": 4,
        "minNumber": 100,
        "roundNumberStep": 50,
        "roundNumberMax": 1000,
        "httpStatusRange": [
          100,
          599
