{
  "mcpServers": {
    "exaix": {
      "command": "deno",
      "args": [
        "run",
        "--allow-read",
        "--allow-write",
        "--allow-net",
        "--allow-env",
        "--allow-ffi",
        "--allow-import",
        "--allow-run=git,deno,npm,node,exoctl,ls,grep,echo,printf,pwd,whoami,id,date,uptime,which,type,command,hash,alias",
        "/absolute/path/to/Exaix/apps/exactl/main.ts",
        "mcp",
        "start"
      ],
      "env": {
        "EXAIX_ROOT": "/absolute/path/to/Exaix"
      }
    }
  }
}
