{
  "$schema": "./schemas/deno-config.schema.json",
  "name": "@dostark/exaix",
  "version": "0.1.0",
  "workspace": [
    "./packages/schemas",
    "./packages/core",
    "./packages/ai",
    "./packages/ai-anthropic",
    "./packages/ai-openai",
    "./packages/ai-google",
    "./packages/ai-ollama",
    "./packages/tui",
    "./packages/mcp",
    "./packages/git",
    "./packages/cli",
    "./packages/testing",
    "./packages/storage-sqlite",
    "./packages/memory",
    "./packages/portal",
    "./packages/quality-gate",
    "./packages/routing",
    "./packages/tool-runtime",
    "./packages/execution",
    "./packages/request",
    "./packages/flow",
    "./apps/daemon",
    "./apps/exactl",
    "./apps/mcp-server",
    "./apps/tui",
    "./apps/agent-entrypoint"
  ],
  "lock": true,
  "exports": "./apps/daemon/main.ts",
  "tasks": {
    "start": "deno run --allow-all apps/exactl/main.ts daemon start",
    "start:fg": "deno run --allow-read=. --allow-write=. --allow-net=api.anthropic.com,api.openai.com,localhost:11434 --allow-env=EXA_,HOME,USER --allow-run=git apps/daemon/main.ts",
    "stop": "deno run --allow-all apps/exactl/main.ts daemon stop",
    "status": "deno run --allow-all apps/exactl/main.ts daemon status",
    "dev": "deno run --watch --allow-all apps/daemon/main.ts",
    "setup": "deno run --allow-all scripts/setup_db.ts",
    "migrate": "deno run --allow-all scripts/migrate_db.ts",
    "check-version": "deno run -A scripts/check_version.ts",
    "check-commit-msg": "deno run -A scripts/check_commit_msg.ts",
    "bump": "deno run -A scripts/check_version.ts --force-patch",
    "cli": "deno run --allow-all apps/exactl/main.ts",
    "tui": "deno run --allow-all apps/tui/main.ts",
    "sandbox": "deno run -A scripts/setup_sandbox.ts",
    "scenario:test": "deno test --allow-all tests/scenario_framework/",
    "scenario:test:unit": "deno test --allow-all tests/scenario_framework/tests/unit/",
    "test": "deno test --allow-all --reporter=dot tests/ packages/",
    "test_verbose": "deno test --allow-all tests/ packages/",
    "test_parallel": "deno run --allow-run --allow-read --allow-env --allow-write scripts/test_parallel.ts --reporter=dot",
    "test:security": "deno test --allow-all --filter \"[security]\" tests/",
    "test:ci": "deno test --allow-all tests/infra/",
    "test:llama": "EXA_RUN_LLAMA_TESTS=true deno test --allow-all tests/llama_provider_test.ts",
    "test:watch": "deno test --watch --allow-all tests/ packages/",
    "test:coverage": "deno run --allow-run --allow-read --allow-write scripts/measure_coverage.ts",
    "coverage": "deno coverage coverage/ --include='^file://.*/(src|packages)/' --exclude='test\\.(ts|js)$'",
    "coverage:html": "deno coverage coverage/ --include='^file://.*/(src|packages)/' --exclude='test\\.(ts|js)$' --html",
    "coverage:lcov": "mkdir -p coverage && deno coverage coverage/ --include='^file://.*/(src|packages)/' --exclude='test\\.(ts|js)$' --lcov --output=coverage/lcov.info",
    "coverage:with-llama": "deno run --allow-run --allow-read --allow-write scripts/measure_coverage.ts --with-llama",
    "bench": "deno bench --allow-all tests/benchmarks/",
    "lint": "deno lint --rules-include=explicit-module-boundary-types --rules-exclude=no-import-prefix tests/ packages/ apps/",
    "fmt": "deno fmt tests/ docs/ packages/ apps/",
    "fmt:check": "deno fmt --check tests/ docs/ packages/ apps/",
    "cache": "deno cache apps/daemon/main.ts apps/exactl/main.ts apps/mcp-server/main.ts apps/tui/main.ts",
    "hooks:install": "deno run --allow-read --allow-write scripts/setup_hooks.ts",
    "check": "deno check packages/ apps/ tests/",
    "check:style": "deno run -A scripts/check_code_style.ts",
    "check:test-placement": "deno run -A scripts/check_test_placement.ts --all",
    "check:docs": "deno run --allow-all scripts/verify_manifest_fresh.ts",
    "dep:graph": "deno run --allow-run --allow-read scripts/package_dependency_graph.ts --entrypoint apps/daemon/main.ts --format text",
    "check:arch": "deno run --allow-read scripts/validate_architecture.ts",
    "check:magic": "deno run -A scripts/check_magic_values.ts",
    "check:tool-result-parity": "deno run -A scripts/check_tool_result_parity.ts",
    "check:complexity": "deno run --allow-run --allow-read scripts/measure_complexity.ts --threshold 15 --fail",
    "measure:duplication": "deno run --allow-run --allow-read --allow-write scripts/measure_duplication.ts",
    "compile": "deno compile --allow-all --output exaix apps/daemon/main.ts",
    "docs-agent-validate": "deno fmt --check *.md && deno run -A scripts/validate_doc_links.ts && deno run -A scripts/validate_cross_reference.ts && grep -q 'copilot_knowledge_base: true' *.md && deno run -A scripts/validate_agents_docs.ts",
    "docs-bench": "deno test -A --filter \"[hallucination-bench]\" tests/docs/",
    "workspace:check": "deno check --unstable ./packages/**",
    "workspace:test": "deno test --allow-all ./packages/**",
    "docs-sync-schemas": "deno run -A scripts/sync_tool_schemas.ts && deno fmt TOOLS.md"
  },
  "imports": {
    "@cliffy/table": "jsr:@cliffy/table@^1.1.0",
    "@std/fs": "jsr:@std/fs@^1.0.23",
    "@std/path": "jsr:@std/path@^1.1.4",
    "@std/toml": "jsr:@std/toml@^1.0.11",
    "@std/yaml": "jsr:@std/yaml@^1.1.0",
    "@std/text": "jsr:@std/text@^1.0.18",
    "@std/crypto": "jsr:@std/crypto@^1.1.0",
    "@std/encoding": "jsr:@std/encoding@^1.0.10",
    "@std/fmt": "jsr:@std/fmt@^1.0.10",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/testing": "jsr:@std/testing@^1.0.18",
    "@db/sqlite": "jsr:@db/sqlite@^0.13.0",
    "@cliffy/command": "jsr:@cliffy/command@^1.1.0",
    "zod": "https://deno.land/x/zod@v3.22.4/mod.ts",
    "typescript": "npm:typescript@6.0.3",
    "@babel/parser": "npm:@babel/parser@7.29.3",
    "@std/flags": "jsr:@std/flags@^0.224.0",
    "@std/streams": "jsr:@std/streams@^1.1.0",
    "@std/io": "jsr:@std/io@^0.225.3",
    "@exaix/ai": "./packages/ai/mod.ts",
    "@exaix/ai-anthropic": "./packages/ai-anthropic/mod.ts",
    "@exaix/ai-anthropic/": "./packages/ai-anthropic/",
    "@exaix/ai-openai": "./packages/ai-openai/mod.ts",
    "@exaix/ai-openai/": "./packages/ai-openai/",
    "@exaix/ai-google": "./packages/ai-google/mod.ts",
    "@exaix/ai-google/": "./packages/ai-google/",
    "@exaix/ai-ollama": "./packages/ai-ollama/mod.ts",
    "@exaix/ai-ollama/": "./packages/ai-ollama/",
    "@exaix/ai/providers": "./packages/ai/src/providers/mod.ts",
    "@exaix/ai/": "./packages/ai/src/",
    "@exaix/mcp": "./packages/mcp/mod.ts",
    "@exaix/mcp/server": "./packages/mcp/server/mod.ts",
    "@exaix/mcp/server/": "./packages/mcp/server/",
    "@exaix/mcp/": "./packages/mcp/src/",
    "@exaix/mcp/testing": "./packages/mcp/testing/mod.ts",
    "@exaix/mcp/testing/": "./packages/mcp/testing/",
    "@exaix/cli": "./packages/cli/mod.ts",
    "@exaix/cli/testing": "./packages/cli/testing/mod.ts",
    "@exaix/cli/testing/": "./packages/cli/testing/",
    "@exaix/cli/": "./packages/cli/src/",
    "@exaix/git": "./packages/git/mod.ts",
    "@exaix/git/": "./packages/git/src/",
    "@exaix/git/testing": "./packages/git/testing/mod.ts",
    "@exaix/git/testing/": "./packages/git/testing/",
    "@exaix/tui": "./packages/tui/mod.ts",
    "@exaix/tui/": "./packages/tui/src/",
    "@exaix/schemas": "./packages/schemas/mod.ts",
    "@exaix/schemas/": "./packages/schemas/src/",
    "@exaix/core": "./packages/core/mod.ts",
    "@exaix/core/types": "./packages/core/src/types/mod.ts",
    "@exaix/core/status": "./packages/core/src/status/mod.ts",
    "@exaix/core/request": "./packages/core/src/request/mod.ts",
    "@exaix/core/observability": "./packages/core/src/observability/mod.ts",
    "@exaix/core/errors": "./packages/core/src/errors/mod.ts",
    "@exaix/core/repositories": "./packages/core/src/repositories/mod.ts",
    "@exaix/core/logger": "./packages/core/src/logger/mod.ts",
    "@exaix/core/config": "./packages/core/src/config/mod.ts",
    "@exaix/core/cost": "./packages/core/src/cost/mod.ts",
    "@exaix/core/": "./packages/core/src/",
    "@exaix/core/func": "./packages/core/src/func/mod.ts",
    "@exaix/core/parsing": "./packages/core/src/parsing/mod.ts",
    "@exaix/core/context": "./packages/core/src/context/mod.ts",
    "@exaix/core/notification": "./packages/core/src/notification/mod.ts",
    "@exaix/core/blueprint": "./packages/core/src/blueprint/mod.ts",
    "@exaix/core/evaluation": "./packages/core/src/evaluation/mod.ts",
    "@exaix/core/skills": "./packages/core/src/skills/mod.ts",
    "@exaix/core/artifact": "./packages/core/src/artifact/mod.ts",
    "@exaix/core/planning": "./packages/core/src/planning/mod.ts",
    "@exaix/testing": "./packages/testing/mod.ts",
    "@exaix/testing/": "./packages/testing/src/",
    "@exaix/storage-sqlite": "./packages/storage-sqlite/mod.ts",
    "@exaix/storage-sqlite/": "./packages/storage-sqlite/src/",
    "@exaix/portal": "./packages/portal/mod.ts",
    "@exaix/portal/knowledge": "./packages/portal/knowledge/mod.ts",
    "@exaix/portal/knowledge/": "./packages/portal/knowledge/",
    "@exaix/portal/": "./packages/portal/src/",
    "@exaix/memory": "./packages/memory/mod.ts",
    "@exaix/memory/testing": "./packages/memory/testing/mod.ts",
    "@exaix/memory/testing/": "./packages/memory/testing/",
    "@exaix/memory/": "./packages/memory/src/",
    "@exaix/quality-gate": "./packages/quality-gate/mod.ts",
    "@exaix/quality-gate/": "./packages/quality-gate/src/",
    "@exaix/routing": "./packages/routing/mod.ts",
    "@exaix/routing/": "./packages/routing/src/",
    "@exaix/tool-runtime": "./packages/tool-runtime/mod.ts",
    "@exaix/execution": "./packages/execution/mod.ts",
    "@exaix/request": "./packages/request/mod.ts",
    "@exaix/request/": "./packages/request/src/",
    "@exaix/flow": "./packages/flow/mod.ts",
    "@exaix/flow/": "./packages/flow/src/"
  },
  "exclude": [
    "cov_profile",
    "exaix",
    "dist"
  ],
  "fmt": {
    "useTabs": false,
    "lineWidth": 120,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": false,
    "proseWrap": "preserve",
    "include": [
      "tests/",
      "docs/",
      "scripts/",
      "packages/",
      "apps/"
    ]
  },
  "test": {
    "include": [
      "tests/",
      "packages/",
      "apps/"
    ]
  },
  "compilerOptions": {
    "lib": ["deno.window", "deno.ns", "deno.unstable"],
    "strict": true,
    "checkJs": false
  }
}
