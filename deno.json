  "lint": {
    "exclude": [
      "tests/scenario_framework/fixtures/"
    ]
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 120,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": false,
    "proseWrap": "preserve",
    "include": [
      "tests/",
      "docs/",
      "scripts/",
      "packages/",
      "packages-team/",
      "apps/"
    ]
  },
  "test": {
    "include": [
