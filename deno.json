{
  "$schema": "./schemas/deno-config.schema.json",
  "name": "@dostark/exaix",
  "version": "0.1.0",
  "nodeModulesDir": "auto",
  "workspace": [
    "./packages/schemas",
    "./packages/core",
    "./packages/ai",
    "./packages/ai-anthropic",
    "./packages/ai-openai",
    "./packages/ai-google",
    "./packages/ai-openrouter",
    "./packages/ai-ollama",
    "./packages/ai-clidelegate",
    "./packages/tui",
    "./packages/mcp",
    "./packages/git",
    "./packages/cli",
    "./packages/testing",
    "./packages/storage-sqlite",
    "./packages/memory",
    "./packages/portal",
    "./packages/quality-gate",
    "./packages/eval-history",
    "./packages/routing",
    "./packages/tool-runtime",
    "./packages/triggers",
    "./packages/execution",
    "./packages/request",
    "./packages/flow",
    "./packages/session",
    "./packages/model-registry",
    "./apps/daemon",
    "./apps/exactl",
    "./apps/mcp-server",
    "./apps/tui",
    "./apps/agent-entrypoint",
    "./packages-team/team-placeholder",
    "./packages-team/team-composer",
    "./packages-team/ai-vertex",
    "./packages-team/mcp-server",
    "./packages-team/model-registry-live"
  ],
  "lock": true,
  "exports": "./apps/daemon/main.ts",
  "tasks": {
    "start": "deno run --allow-read --allow-write --allow-net --allow-env --allow-ffi --allow-import --allow-run=git,deno,npm,node,exoctl,ls,grep,echo,printf,pwd,whoami,id,date,uptime,which,type,command,hash,alias apps/exactl/main.ts daemon start",
    "start:unsafe": "deno run --allow-all apps/exactl/main.ts daemon start",
    "start:fg": "deno run --allow-read=. --allow-write=. --allow-net=api.anthropic.com,api.openai.com,localhost:11434 --allow-env=EXA_,HOME,USER --allow-run=git apps/daemon/main.ts",
    "stop": "deno run --allow-read --allow-write --allow-net --allow-env --allow-ffi --allow-import --allow-run=git,deno,npm,node,exoctl,ls,grep,echo,printf,pwd,whoami,id,date,uptime,which,type,command,hash,alias apps/exactl/main.ts daemon stop",
    "status": "deno run --allow-read --allow-write --allow-net --allow-env --allow-ffi --allow-import --allow-run=git,deno,npm,node,exoctl,ls,grep,echo,printf,pwd,whoami,id,date,uptime,which,type,command,hash,alias apps/exactl/main.ts daemon status",
    "dev": "deno run --watch --allow-read --allow-write --allow-net --allow-env --allow-ffi --allow-import --allow-run=git,deno,npm,node,exoctl,ls,grep,echo,printf,pwd,whoami,id,date,uptime,which,type,command,hash,alias apps/daemon/main.ts",
    "dev:unsafe": "deno run --watch --allow-all apps/daemon/main.ts",
    "setup": "deno run --allow-all scripts/setup_db.ts",
    "migrate": "deno run --allow-all scripts/migrate_db.ts",
    "bump": "deno run -A scripts/check_version.ts --force-patch",
    "cli": "deno run --allow-read --allow-write --allow-net --allow-env --allow-ffi --allow-import --allow-run=git,deno,npm,node,exoctl,ls,grep,echo,printf,pwd,whoami,id,date,uptime,which,type,command,hash,alias apps/exactl/main.ts",
    "cli:unsafe": "deno run --allow-all apps/exactl/main.ts",
    "tui": "deno run --allow-read --allow-write --allow-net --allow-env --allow-ffi --allow-import --allow-run=git,deno,npm,node,exoctl,ls,grep,echo,printf,pwd,whoami,id,date,uptime,which,type,command,hash,alias apps/tui/main.ts",
    "tui:unsafe": "deno run --allow-all apps/tui/main.ts",
    "sandbox": "deno run -A scripts/setup_sandbox.ts",
    "scenario:test": "deno test --allow-all tests/scenario_framework/",
    "scenario:test:unit": "deno test --allow-all tests/scenario_framework/tests/unit/",
    "scenario:prune": "deno run --allow-read --allow-write --allow-env scripts/prune_scenario_sandboxes.ts",
    "test": "deno run --allow-run --allow-read --allow-env --allow-write scripts/test_parallel.ts --reporter=dot",
    "test_verbose": "deno test --allow-all tests/ packages/ packages-team/ apps/",
    "test:solo": "deno test --allow-all --reporter=dot tests/ packages/ apps/",
    "test:team": "deno test --allow-all --reporter=dot tests/ packages/ packages-team/ apps/",
    "test_parallel": "EXAIX_EDITION=solo deno run --allow-run --allow-read --allow-env --allow-write scripts/test_parallel.ts --reporter=dot",
    "test_parallel:team": "EXAIX_EDITION=team deno run --allow-run --allow-read --allow-env --allow-write scripts/test_parallel.ts --reporter=dot",
    "test_parallel:pretty": "EXAIX_EDITION=solo deno run --allow-run --allow-read --allow-env --allow-write scripts/test_parallel.ts --reporter=pretty",
    "test:security": "deno test --allow-all --filter \"[security]\" tests/",
    "test:parity": "deno test --allow-all tests/eval/catalog_parity_harness_test.ts tests/eval/flow_eval_parity_test.ts tests/eval/identity_eval_parity_test.ts tests/eval/skill_eval_parity_test.ts tests/eval/tool_eval_parity_test.ts",
    "eval:subsystems": "deno run -A tests/scenario_framework/runner/main.ts --profile ci-extended --tag subsystem:tools --tag subsystem:mcp-server --tag subsystem:mcp-client --tag subsystem:identities --tag subsystem:skills --tag subsystem:flows --mode auto --eval-mode --score-threshold 0.7",
    "eval:subsystems:core": "deno run -A tests/scenario_framework/runner/main.ts --profile ci-core --mode auto --eval-mode --score-threshold 0.7",
    "eval:jail:build": "docker build --target eval-jail -t exaix-eval-jail .",
    "test:team-smoke": "deno test --allow-all --filter \"[team]\" tests/",
    "test:ci": "deno test --allow-all tests/infra/",
    "test:llama": "EXA_RUN_LLAMA_TESTS=true deno test --allow-all tests/llama_provider_test.ts",
    "test:watch": "deno test --watch --allow-all tests/ packages/ packages-team/ apps/",
    "test:coverage": "deno run --allow-run --allow-read --allow-write scripts/measure_coverage.ts",
    "coverage": "deno coverage coverage/ --include='^file://.*/(src|packages)/' --exclude='test\\.(ts|js)$'",
    "coverage:html": "deno coverage coverage/ --include='^file://.*/(src|packages)/' --exclude='test\\.(ts|js)$' --html",
    "coverage:lcov": "mkdir -p coverage && deno coverage coverage/ --include='^file://.*/(src|packages)/' --exclude='test\\.(ts|js)$' --lcov --output=coverage/lcov.info",
    "coverage:with-llama": "deno run --allow-run --allow-read --allow-write scripts/measure_coverage.ts --with-llama",
    "bench": "deno bench --allow-all tests/benchmarks/",
    "lint": "deno lint --rules-include=explicit-module-boundary-types --rules-exclude=no-import-prefix tests/ packages/ packages-team/ apps/",
    "fmt": "deno fmt tests/ docs/ packages/ packages-team/ apps/",
    "fmt:check": "deno fmt --check tests/ docs/ packages/ packages-team/ apps/",
    "cache": "deno cache apps/daemon/main.ts apps/exactl/main.ts apps/mcp-server/main.ts apps/tui/main.ts",
    "hooks:install": "deno run --allow-read --allow-write scripts/setup_hooks.ts",
    "check": "deno check packages/ packages-team/ apps/ tests/",
    "check:version": "deno run -A scripts/check_version.ts",
    "check:commit-msg": "deno run --allow-read --allow-run=git scripts/check_commit_msg.ts",
    "check:style": "deno run --allow-read --allow-env scripts/check_code_style.ts",
    "check:edition-graph": "deno run --allow-read --allow-run=deno --allow-env scripts/check_edition_graph.ts",
    "check:test-placement": "deno run --allow-read --allow-run=git scripts/check_test_placement.ts --all",
    "check:docs": "deno run --allow-read scripts/verify_manifest_fresh.ts",
    "dep:graph": "deno run --allow-run --allow-read scripts/package_dependency_graph.ts --entrypoint apps/daemon/main.ts --format text",
    "check:arch": "deno run --allow-read scripts/validate_architecture.ts",
    "check:magic": "deno run --allow-read --allow-env scripts/check_magic_values.ts",
    "check:god-objects": "deno run -A scripts/check_god_objects.ts --fail",
    "check:agent-docs-integrity": "deno run --allow-read scripts/check_agent_docs_integrity.ts",
    "check:phase-references": "deno run --allow-read scripts/check_phase_references.ts",
    "check:qwen-skills-sync": "deno run --allow-read scripts/check_qwen_skills_sync.ts",
    "check:hardcoded-models": "deno run --allow-read scripts/check_hardcoded_models.ts",
    "check:event-strings": "deno run --allow-read scripts/check_event_strings.ts",
    "check:scenario-declarative": "deno run -A scripts/check_scenario_declarative.ts",
    "check:constant-restatement": "deno run --allow-read scripts/check_constant_restatement.ts",
    "verify:pack-mutations": "deno run -A scripts/verify_pack_mutations.ts",
    "check:leak-guard": "deno run --allow-read scripts/leak_guard.ts",
    "check:no-edition-conditionals": "deno run --allow-read --allow-run=grep scripts/check_no_edition_conditionals.ts",
    "check:tool-result-parity": "deno run -A scripts/check_tool_result_parity.ts",
    "check:complexity": "deno run --allow-run --allow-read scripts/measure_complexity.ts --threshold 15 --fail",
    "check:unused-exports": "deno run -A scripts/check_unused_exports.ts",
    "check:unused-exports:strict": "deno run -A scripts/check_unused_exports.ts --strict",
    "check:optional-params": "deno run --allow-read --allow-env --allow-run=git scripts/check_optional_params.ts",
    "check:optional-params:staged": "deno run --allow-read --allow-env --allow-run=git scripts/check_optional_params.ts --staged",
    "check:runtime-artifacts": "deno run --allow-read --allow-run=git scripts/check_runtime_artifacts.ts",
    "check:skill-envelopes": "deno run --allow-read --allow-write=/tmp scripts/generate_skill_json.ts /tmp/skill-env-check-target /tmp/skill-env-check-root --check",
    "check:skill-index": "deno run --allow-read scripts/build_skills_index.ts Memory/Skills . --check",
    "check:blueprint-integrity": "deno run --allow-read scripts/check_blueprint_integrity.ts Blueprints",
    "check:manifests": "deno run --allow-read scripts/check_step_manifests.ts exaix-dev-docs/planning/ --since 130",
    "check:reachability-ledger": "deno run --allow-read scripts/check_reachability_ledger.ts",
    "check:config-keys": "deno run --allow-read scripts/check_config_keys.ts",
    "check:md-path": "deno run --allow-read --allow-run=git scripts/check_md_paths.ts .",
    "check:md-path:staged": "deno run --allow-read --allow-run=git scripts/check_md_paths.ts . --staged",
    "check:md-path:fix": "deno run --allow-read --allow-write --allow-run=git scripts/check_md_paths.ts . --fix",
    "check:duplication": "deno run --allow-run --allow-read --allow-write scripts/measure_duplication.ts",
    "measure:duplication": "deno run --allow-run --allow-read --allow-write scripts/measure_duplication.ts",
    "compile": "deno compile --allow-read --allow-write --allow-net --allow-env --allow-ffi --allow-import --allow-run=git,deno,npm,node,exoctl,ls,grep,echo,printf,pwd,whoami,id,date,uptime,which,type,command,hash,alias --output exaix apps/daemon/main.ts",
    "compile:unsafe": "deno compile --allow-all --output exaix apps/daemon/main.ts",
    "docs-agent-validate": "deno fmt --check *.md && deno run --allow-read scripts/validate_doc_links.ts && grep -q 'copilot_knowledge_base: true' *.md && deno run --allow-read scripts/validate_agents_docs.ts",
    "docs-bench": "deno test -A --filter \"[hallucination-bench]\" tests/docs/",
    "workspace:check": "deno check --unstable ./packages/** ./packages-team/**",
    "workspace:test": "deno test --allow-all ./packages/** ./packages-team/**",
    "docs-sync-schemas": "deno run -A scripts/sync_tool_schemas.ts && deno fmt .copilot/docs/TOOLS.md",
    "build:solo": "deno run -A scripts/ci.ts build --edition solo",
    "build:team": "deno run -A scripts/ci.ts build --edition team",
    "build:enterprise": "deno run -A scripts/ci.ts build --edition enterprise",
    "ci:solo": "deno run -A scripts/ci.ts all --edition solo",
    "ci:team": "deno run -A scripts/ci.ts all --edition team",

    "dogfood": "deno run -A scripts/dogfood_daemon.ts start",
    "dogfood:stop": "deno run -A scripts/dogfood_daemon.ts stop",
    "dogfood:status": "deno run -A scripts/dogfood_daemon.ts status",
    "dogfood:log": "deno run -A scripts/dogfood_daemon.ts log",
    "dogfood:bootstrap": "deno run -A scripts/dogfood_bootstrap.ts",
    "dogfood:clean": "deno run -A scripts/dogfood_clean.ts",
    "build:mock-tool": "deno run -A scripts/build_mock_session_tool.ts"
  },
