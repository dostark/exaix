{
  "$schema": "./schemas/deno-config.schema.json",
  "name": "@dostark/exaix",
  "version": "0.1.0",
  "workspace": [
    "./packages/schemas",
    "./packages/parsing",
    "./packages/core",
    "./packages/ai",
    "./packages/testing",
    "./packages/memory"
  ],
  "lock": true,
  "exports": "./src/main.ts",
  "tasks": {
    "start": "deno run --allow-all src/cli/exactl.ts daemon start",
    "start:fg": "deno run --allow-read=. --allow-write=. --allow-net=api.anthropic.com,api.openai.com,localhost:11434 --allow-env=EXA_,HOME,USER --allow-run=git src/main.ts",
    "stop": "deno run --allow-all src/cli/exactl.ts daemon stop",
    "status": "deno run --allow-all src/cli/exactl.ts daemon status",
    "dev": "deno run --watch --allow-all src/main.ts",
    "setup": "deno run --allow-all scripts/setup_db.ts",
    "migrate": "deno run --allow-all scripts/migrate_db.ts",
    "check-version": "deno run -A scripts/check_version.ts",
    "check-commit-msg": "deno run -A scripts/check_commit_msg.ts",
    "bump": "deno run -A scripts/check_version.ts --force-patch",
    "cli": "deno run --allow-all src/cli/exactl.ts",
    "sandbox": "deno run -A scripts/setup_sandbox.ts",
    "scenario:test": "deno test --allow-all tests/scenario_framework/",
    "scenario:test:unit": "deno test --allow-all tests/scenario_framework/tests/unit/",
    "test": "deno test --allow-all --reporter=dot",
    "test_verbose": "deno test --allow-all",
    "test_parallel": "deno run --allow-run --allow-read --allow-env --allow-write scripts/test_parallel.ts --reporter=dot",
    "test:security": "deno test --allow-all --filter \"[security]\" tests/",
    "test:ci": "deno test --allow-all tests/infra/",
    "test:llama": "EXA_RUN_LLAMA_TESTS=true deno test --allow-all tests/llama_provider_test.ts",
    "test:watch": "deno test --watch --allow-all tests/",
    "test:coverage": "deno run --allow-run --allow-read --allow-write scripts/measure_coverage.ts",
    "coverage": "deno coverage coverage/ --include='^file://.*Exaix/src/' --exclude='test\\.(ts|js)$'",
    "coverage:html": "deno coverage coverage/ --include='^file://.*Exaix/src/' --exclude='test\\.(ts|js)$' --html",
    "coverage:lcov": "mkdir -p coverage && deno coverage coverage/ --include='^file://.*Exaix/src/' --exclude='test\\.(ts|js)$' --lcov --output=coverage/lcov.info",
    "coverage:with-llama": "deno run --allow-run --allow-read --allow-write scripts/measure_coverage.ts --with-llama",
    "bench": "deno bench --allow-all tests/benchmarks/",
    "lint": "deno lint --rules-include=explicit-module-boundary-types --rules-exclude=no-import-prefix src/ tests/",
    "fmt": "deno fmt src/ tests/ docs/",
    "fmt:check": "deno fmt --check src/ tests/ docs/",
    "cache": "deno cache src/main.ts",
    "hooks:install": "deno run --allow-read --allow-write scripts/setup_hooks.ts",
    "check": "deno check src/main.ts",
    "check:style": "deno run -A scripts/check_code_style.ts",
    "check:test-placement": "deno run -A scripts/check_test_placement.ts --all",
    "check:docs": "deno run --allow-all scripts/verify_manifest_fresh.ts",
    "check:arch": "deno run --allow-read scripts/validate_architecture.ts",
    "check:magic": "deno run -A scripts/check_magic_values.ts",
    "check:complexity": "deno run --allow-run --allow-read scripts/measure_complexity.ts --threshold 15 --fail",
    "measure:duplication": "deno run --allow-run --allow-read --allow-write scripts/measure_duplication.ts",
    "compile": "deno compile --allow-all --output exaix src/main.ts",
    "docs-agent-validate": "deno fmt --check *.md && deno run -A scripts/validate_doc_links.ts && deno run -A scripts/validate_cross_reference.ts && grep -q 'copilot_knowledge_base: true' *.md",
    "docs-bench": "deno test -A --filter \"[hallucination-bench]\" tests/docs/",
    "workspace:check": "deno check --unstable ./packages/**",
    "workspace:test": "deno test --allow-all ./packages/**",
    "docs-sync-schemas": "deno run -A scripts/sync_tool_schemas.ts && deno fmt TOOLS.md"
  },
  "imports": {
    "@cliffy/table": "jsr:@cliffy/table@^1.0.0-rc.8",
    "@std/fs": "jsr:@std/fs@^0.221.0",
    "@std/path": "jsr:@std/path@^0.221.0",
    "@std/toml": "jsr:@std/toml@^0.221.0",
    "@std/yaml": "jsr:@std/yaml@^1.0.0",
    "@std/text": "jsr:@std/text@^0.221.0",
    "@std/crypto": "jsr:@std/crypto@^0.221.0",
    "@std/encoding": "jsr:@std/encoding@^0.221.0",
    "@std/fmt": "jsr:@std/fmt@^0.221.0",
    "@std/assert": "jsr:@std/assert@^1.0.0",
    "@std/testing": "jsr:@std/testing@^1.0.0",
    "@db/sqlite": "jsr:@db/sqlite@^0.11.0",
    "@cliffy/command": "jsr:@cliffy/command@^1.0.0-rc.8",
    "deno-tui": "https://deno.land/x/deno_tui@v1.1.1/mod.ts",
    "zod": "https://deno.land/x/zod@v3.22.4/mod.ts",
    "typescript": "npm:typescript@5.3.3",
    "@babel/parser": "npm:@babel/parser@7.24.4",
    "@std/flags": "jsr:@std/flags@^0.221.0",
    "@std/streams": "jsr:@std/streams@^1.0.17",
    "@exaix/schemas": "./packages/schemas/mod.ts",
    "@exaix/schemas/": "./packages/schemas/src/",
    "@exaix/parsing": "./packages/parsing/mod.ts",
    "@exaix/parsing/": "./packages/parsing/src/",
    "@exaix/core": "./packages/core/mod.ts",
    "@exaix/core/": "./packages/core/src/",
    "@exaix/testing": "./packages/testing/mod.ts",
    "@exaix/testing/": "./packages/testing/src/"
  },
  "exclude": [
    "cov_profile",
    "exaix",
    "dist"
  ],
  "fmt": {
    "useTabs": false,
    "lineWidth": 120,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": false,
    "proseWrap": "preserve",
    "include": [
      "src/",
      "tests/",
      "docs/",
      "scripts/"
    ]
  },
  "test": {
    "include": ["tests/"]
  },
  "compilerOptions": {
    "lib": ["deno.window", "deno.ns", "deno.unstable"],
    "strict": true,
    "checkJs": false
  }
}
