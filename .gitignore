# ============================================
# Exaix .gitignore (Phase 19)
# ============================================

# --------------------------------------------
# VS Code Settings
# --------------------------------------------
.vscode/settings.json

# --------------------------------------------
# Claude Code local settings (machine-specific)
# --------------------------------------------
.copilot/settings.local.json
# Harness-written session/scheduler runtime state (carries a live PID + session id).
# A stale .lock left behind is a useful signal of an unclean shutdown, so we ignore it
# rather than auto-delete it — inspect it, then remove it manually if it's truly orphaned.
.copilot/scheduled_tasks.lock

# --------------------------------------------
# Build & Cache
# --------------------------------------------
/.cache
dist/
**/*.log

# --------------------------------------------
# Dogfooding workspace (Phase 120)
# --------------------------------------------
.dogfood/
logs/


# --------------------------------------------
# Test Artifacts
# --------------------------------------------
/coverage*/
.coverage/
jscpd-report/
report/
test-*.toml
cov_profile/
.duplication_report/
tests/scenario_framework/output/

# Scenario execution leftovers (self-contained eval scenarios)
/artifacts/
/eval-test/

# Allow duplication report artifacts
.duplication_report*/

# --------------------------------------------
# Runtime State (.exa/)
# --------------------------------------------
# .exa/ is a predefined Exaix runtime directory that is deployed (its structure may be
# tracked); only its RUNTIME CONTENTS are ignored, never the directory itself. Scenario/
# dogfood sandboxes deploy OUTSIDE the repo tree (sibling-of-repo default, or
# EXA_SANDBOX_BASE), so these patterns are a backstop against stray runtime files only.
.exa/*.db
.exa/*.db-shm
.exa/*.db-wal
.exa/daemon.pid
.exa/daemon.log
.exa/cache/
.exa/activity_export.md
.exa/migration-backup/

# --------------------------------------------
# Workspace (User Content)
# --------------------------------------------
Workspace/Requests/
Workspace/Rejected/
Workspace/Plans/
Workspace/Active/
Workspace/Archive/

# --------------------------------------------
# Integration (External Projects)
# --------------------------------------------
Portals/

# --------------------------------------------
# Build Artifacts
# --------------------------------------------
exaix
/.ci-bin/

# Config files
exa.config.toml
# Qwen Code runtime state
.qwen/settings.json


.copilot/manifest.json
/Memory/*
!/Memory/**/.gitkeep
!/Memory/Skills/

# Local SSH deploy key for CI submodule checkout
.github/deploy_key
.github/deploy_key.pub
