# ============================================
# Exaix .gitignore (Phase 19)
# ============================================

# --------------------------------------------
# VS Code Settings
# --------------------------------------------
.vscode/settings.json

# --------------------------------------------
# Claude Code local settings (machine-specific)
# --------------------------------------------
.copilot/settings.local.json

# --------------------------------------------
# Build & Cache
# --------------------------------------------
/.cache
dist/
**/*.log

# --------------------------------------------
# Dogfooding workspace (Phase 120)
# --------------------------------------------
.dogfood/
logs/


# --------------------------------------------
# Test Artifacts
# --------------------------------------------
/coverage*/
.coverage/
jscpd-report/
report/
test-*.toml
cov_profile/
.duplication_report/
tests/scenario_framework/output/

# Scenario execution leftovers (self-contained eval scenarios)
/artifacts/
/eval-test/

# Allow duplication report artifacts
.duplication_report*/

# --------------------------------------------
# Runtime State (.exa/)
# --------------------------------------------
.exa/*.db
.exa/*.db-shm
.exa/*.db-wal
.exa/daemon.pid
.exa/daemon.log
.exa/cache/
.exa/activity_export.md
.exa/migration-backup/

# --------------------------------------------
# Workspace (User Content)
# --------------------------------------------
Workspace/Requests/
Workspace/Rejected/
Workspace/Plans/
Workspace/Active/
Workspace/Archive/

# --------------------------------------------
# Integration (External Projects)
# --------------------------------------------
Portals/

# --------------------------------------------
# Build Artifacts
# --------------------------------------------
exaix
/.ci-bin/

# Config files
exa.config.toml
# Qwen Code runtime state
.qwen/settings.json

# Agent doc pre-chunks (auto-generated)
.copilot/chunks/
.copilot/manifest.json
/Memory/*
!/Memory/**/.gitkeep
!/Memory/Skills/

# Local SSH deploy key for CI submodule checkout
.github/deploy_key
.github/deploy_key.pub
