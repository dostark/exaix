   res.status(201).json(task);
 }
 
-// No handler exists yet for marking a task complete (PATCH /tasks/:id/complete).
+export function handleSearchTasks(repo: TaskRepository, req: IRequest, res: IResponse): void {
+  const query = typeof req.body.query === "string" ? req.body.query.toLowerCase() : "";
+  if (!query) {
+    res.status(400).json({ error: "Query must be a non-empty string" });
+    return;
+  }
+  const results = repo.list().filter((t) => {
+    const titleMatch = t.title.toLowerCase().includes(query);
+    const assigneeMatch = t.assignee && t.assignee.name.toLowerCase().includes(query);
+    return titleMatch || assigneeMatch;
+  });
+  res.json(results);
+}
