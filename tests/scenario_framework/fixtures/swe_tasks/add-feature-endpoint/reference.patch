diff --git a/src/api.ts b/src/api.ts
index 0bf722a..15edabe 100644
--- a/src/api.ts
+++ b/src/api.ts
@@ -46,4 +46,12 @@ export function handleCreateTask(repo: TaskRepository, req: IRequest, res: IResp
   res.status(201).json(task);
 }
 
-// No handler exists yet for marking a task complete (PATCH /tasks/:id/complete).
+export function handleCompleteTask(repo: TaskRepository, req: IRequest, res: IResponse): void {
+  const existing = repo.get(req.params.id);
+  if (!existing) {
+    res.status(404).json({ error: "Task not found" });
+    return;
+  }
+  repo.update(req.params.id, { done: true });
+  res.json(repo.get(req.params.id));
+}
