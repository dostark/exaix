+/**
+ * @module ApiRoutesTest
+ * @path src/api_routes_test.ts
+ * @description Tests for route constants.
+ */
+
+import { assertEquals } from "jsr:@std/assert@1";
+import { ROUTE_GET_TASK, ROUTE_LIST_TASKS, ROUTE_CREATE_TASK, ROUTE_COMPLETE_TASK } from "./api_routes.ts";
+
+Deno.test("route constants have correct path values", () => {
+  assertEquals(ROUTE_GET_TASK, "/tasks/:id");
+  assertEquals(ROUTE_LIST_TASKS, "/tasks");
+  assertEquals(ROUTE_CREATE_TASK, "/tasks");
+  assertEquals(ROUTE_COMPLETE_TASK, "/tasks/:id/complete");
+});
