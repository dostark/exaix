+/**
+ * @module BatchOperationsTest
+ * @path src/batch_operations_test.ts
+ * @description Tests for batch operations.
+ */
+
+import { assertEquals } from "jsr:@std/assert@1";
+import { TaskRepository } from "./storage.ts";
+import { batchUpdateStatus, batchDeleteByPriority } from "./batch_operations.ts";
+
+Deno.test("batchUpdateStatus marks multiple tasks as done", () => {
+  const repo = new TaskRepository();
+  repo.add({ id: "1", title: "A", priority: "low", done: false, dueDate: null, assignee: null });
+  repo.add({ id: "2", title: "B", priority: "low", done: false, dueDate: null, assignee: null });
+  repo.add({ id: "3", title: "C", priority: "low", done: false, dueDate: null, assignee: null });
+
+  const updated = batchUpdateStatus(repo, ["1", "3"], true);
+
+  assertEquals(updated.length, 2);
+  assertEquals(repo.get("1")?.done, true);
+  assertEquals(repo.get("2")?.done, false);
+});
+
+Deno.test("batchUpdateStatus skips missing ids", () => {
+  const repo = new TaskRepository();
+  repo.add({ id: "1", title: "A", priority: "low", done: false, dueDate: null, assignee: null });
+
+  const updated = batchUpdateStatus(repo, ["1", "missing"], true);
+
+  assertEquals(updated.length, 1);
+});
+
+Deno.test("batchDeleteByPriority removes all tasks of a given priority", () => {
+  const repo = new TaskRepository();
+  repo.add({ id: "1", title: "A", priority: "low", done: false, dueDate: null, assignee: null });
+  repo.add({ id: "2", title: "B", priority: "medium", done: false, dueDate: null, assignee: null });
+  repo.add({ id: "3", title: "C", priority: "low", done: false, dueDate: null, assignee: null });
+
+  const deleted = batchDeleteByPriority(repo, "low");
+
+  assertEquals(deleted, 2);
+  assertEquals(repo.list().length, 1);
+});
