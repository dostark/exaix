+/**
+ * @module BatchOperations
+ * @path src/batch_operations.ts
+ * @description Batch operations for task management.
+ */
+
+import { TaskRepository } from "./storage.ts";
+import type { ITask, Priority } from "./models.ts";
+
+export function batchUpdateStatus(repo: TaskRepository, ids: string[], done: boolean): ITask[] {
+  const updated: ITask[] = [];
+  for (const id of ids) {
+    const task = repo.get(id);
+    if (task) {
+      repo.update(id, { done });
+      const updatedTask = repo.get(id);
+      if (updatedTask) updated.push(updatedTask);
+    }
+  }
+  return updated;
+}
+
+export function batchDeleteByPriority(repo: TaskRepository, priority: Priority): number {
+  const tasks = repo.list();
+  const toDelete = tasks.filter((t) => t.priority === priority);
+  for (const t of toDelete) {
+    repo.remove(t.id);
+  }
+  return toDelete.length;
+}
