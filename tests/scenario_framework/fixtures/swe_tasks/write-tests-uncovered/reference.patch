+/**
+ * @module TodoAppPriorityCalculatorTest
+ * @path src/priority_calculator_test.ts
+ * @description swe_tasks fixture portal: comprehensive tests for priority_calculator.ts.
+ */
+
+import { assertEquals } from "jsr:@std/assert@1";
+import { daysUntilDue, escalatedPriority, sortByEscalatedPriority } from "./priority_calculator.ts";
+import type { ITask } from "./models.ts";
+
+function makeTask(overrides: Partial<ITask> = {}): ITask {
+  return {
+    id: "t1",
+    title: "Test",
+    priority: "low",
+    done: false,
+    dueDate: null,
+    assignee: null,
+    ...overrides,
+  };
+}
+
+Deno.test("daysUntilDue returns null for a task with no due date", () => {
+  assertEquals(daysUntilDue(makeTask()), null);
+});
+
+Deno.test("daysUntilDue returns null for a malformed due date", () => {
+  assertEquals(daysUntilDue(makeTask({ dueDate: "not-a-date" })), null);
+});
+
+Deno.test("daysUntilDue returns N for a task due in N days", () => {
+  const now = new Date("2025-06-01T00:00:00Z");
+  const future = new Date("2025-06-05T00:00:00Z");
+  const task = makeTask({ dueDate: future.toISOString() });
+  assertEquals(daysUntilDue(task, now), 4);
+});
+
+Deno.test("escalatedPriority does not escalate a done task", () => {
+  const task = makeTask({ done: true, priority: "low", dueDate: "2025-06-01T00:00:00Z" });
+  assertEquals(escalatedPriority(task, new Date("2025-05-30T00:00:00Z")), "low");
+});
+
+Deno.test("escalatedPriority escalates low to medium when due within 2 days", () => {
+  const now = new Date("2025-06-03T00:00:00Z");
+  const due = new Date("2025-06-05T00:00:00Z");
+  const task = makeTask({ priority: "low", dueDate: due.toISOString() });
+  assertEquals(escalatedPriority(task, now), "medium");
+});
+
+Deno.test("escalatedPriority escalates medium to high when due within 2 days", () => {
+  const now = new Date("2025-06-03T00:00:00Z");
+  const due = new Date("2025-06-05T00:00:00Z");
+  const task = makeTask({ priority: "medium", dueDate: due.toISOString() });
+  assertEquals(escalatedPriority(task, now), "high");
+});
+
+Deno.test("escalatedPriority makes an overdue task high", () => {
+  const task = makeTask({ priority: "low", dueDate: "2025-01-01T00:00:00Z" });
+  assertEquals(escalatedPriority(task, new Date("2025-06-01T00:00:00Z")), "high");
+});
+
+Deno.test("escalatedPriority does not escalate high further", () => {
+  const now = new Date("2025-06-03T00:00:00Z");
+  const due = new Date("2025-06-05T00:00:00Z");
+  const task = makeTask({ priority: "high", dueDate: due.toISOString() });
+  assertEquals(escalatedPriority(task, now), "high");
+});
+
+Deno.test("sortByEscalatedPriority orders by escalated priority then due date", () => {
+  const tasks = [
+    makeTask({ id: "1", priority: "low", dueDate: "2025-06-10T00:00:00Z" }),
+    makeTask({ id: "2", priority: "high", dueDate: "2025-07-01T00:00:00Z" }),
+    makeTask({ id: "3", priority: "low", dueDate: "2025-06-05T00:00:00Z" }),
+  ];
+  const now = new Date("2025-06-01T00:00:00Z");
+  const sorted = sortByEscalatedPriority(tasks, now);
+  assertEquals(sorted[0].id, "2");
+  assertEquals(sorted[1].id, "3");
+  assertEquals(sorted[2].id, "1");
+});
+
+Deno.test("sortByEscalatedPriority puts tasks with no due date at the end within same priority", () => {
+  const tasks = [
+    makeTask({ id: "1", priority: "low", dueDate: null }),
+    makeTask({ id: "2", priority: "low", dueDate: "2025-06-10T00:00:00Z" }),
+  ];
+  const now = new Date("2025-06-01T00:00:00Z");
+  const sorted = sortByEscalatedPriority(tasks, now);
+  assertEquals(sorted[0].id, "2");
+  assertEquals(sorted[1].id, "1");
+});
