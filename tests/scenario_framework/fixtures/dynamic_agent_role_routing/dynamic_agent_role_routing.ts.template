import { join } from "@std/path";
import { RequestRouter } from "@exaix/request";
import { RoutingPolicyService, RoutingPolicyLoader, CandidateDiscovery } from "@exaix/routing";
import { IBlueprintLoader } from "@exaix/core/blueprint";

const root = Deno.cwd();
const selectedAgentRole = "senior-coder";
const defaultAgent = "default-agent";
const request = {
  traceId: "scenario-trace-1",
  requestId: "scenario-request-1",
  frontmatter: {
    allow_dynamic_routing: true,
    capability: "code_review",
    language: "typescript",
    portal_type: "api",
  },
  body: "Please review the API implementation.",
};

const config = {
  routing: {
    enabled: true,
    enable_dynamic_routing: true,
    policy_path: ".exa/routing.policy.yaml",
    experiment_salt: "scenario-dynamic-routing",
  },
};

const routingPolicyService = new RoutingPolicyService({
  policyLoader: new RoutingPolicyLoader({ config, root }),
  candidateDiscovery: new CandidateDiscovery(
    new IBlueprintLoader({ blueprintsPath: join(root, "Blueprints", "Agents") }),
  ),
  performanceRepository: { getPerformanceByCapability: async () => [] },
  experimentSalt: config.routing?.experiment_salt ?? "scenario-dynamic-routing",
});

const logger = {
  log: async () => {},
  info: async () => {},
  warn: async () => {},
  error: async () => {},
  fatal: async () => {},
  debug: async () => {},
  child() {
    return this;
  },
};

const router = new RequestRouter({
  flowRunner: {
    execute: async () => ({
      flowRunId: "",
      success: true,
      stepResults: new Map(),
      output: "",
      duration: 0,
      startedAt: new Date(),
      completedAt: new Date(),
    }),
  },
  agentRunner: {
    run: async () => ({ thought: "", content: "", raw: "" }),
  },
  flowValidator: {
    validateFlow: async () => ({ valid: true }),
  },
  eventLogger: logger,
  defaultAgentId: defaultAgent,
  blueprintsPath: join(root, "Blueprints", "Agents"),
  config,
  routingPolicyService,
});

const result = await router.route(request as any);
if (result.agentRole !== selectedAgentRole) {
  throw new Error(`Unexpected selected agent_role: ${result.agentRole}`);
}

await Deno.mkdir(join(root, "artifacts"), { recursive: true });
await Deno.writeTextFile(
  join(root, "artifacts", "result.json"),
  JSON.stringify({ selected_agent_role: result.agentRole }),
);
