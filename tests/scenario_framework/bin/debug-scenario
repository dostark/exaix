#!/usr/bin/env bash
# debug-scenario — run ONE scenario verbosely, capture everything, and point you at the evidence.
#
# This is the entry point for debugging a failing e2e scenario. It runs a single scenario in AUTO mode
# with --verbose, tees the full output to a log, then prints: the outcome, the failing step (if any),
# the sandbox the run created, and the exact follow-up commands (journal / delegate-inspect) to read
# the real evidence. It encodes the LIVE-RT debugging loop: run one scenario, read the failing step,
# then go to the journal and the delegate artifacts — never trust the runner's exit code alone.
#
# Usage:
#   debug-scenario <scenario-id> [extra runner flags...]
#   debug-scenario session-delegate-matrix-live
#   debug-scenario plan-amendment-lifecycle --trials 1
#
# Output log: written to <sandbox-base>/debug-<scenario>-<timestamp>.log (and path printed at the end).
set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
FRAMEWORK_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../../.." && pwd)"

SCENARIO="${1:-}"
if [ -z "$SCENARIO" ]; then
  echo "usage: debug-scenario <scenario-id> [extra runner flags...]" >&2
  echo "  list ids:  deno run --allow-all $FRAMEWORK_ROOT/runner/main.ts --dry-run --pack <pack>" >&2
  exit 2
fi
shift || true

BASE="$("$SCRIPT_DIR/sandbox" base)"
mkdir -p "$BASE"
LOG="$BASE/debug-${SCENARIO}-$(date '+%Y%m%d-%H%M%S').log"

echo "▶ Running scenario '$SCENARIO' (verbose, AUTO mode) …"
echo "  log: $LOG"
echo "  tip: a provider-live scenario needs its binary + API key on the env (e.g. claude + ANTHROPIC_API_KEY)."
echo

# Snapshot existing sandboxes so we can identify the one THIS run creates.
before="$(mktemp)"
"$SCRIPT_DIR/sandbox" list 2>/dev/null | awk '{print $3}' > "$before" || true

deno run --allow-all "$FRAMEWORK_ROOT/runner/main.ts" \
  --scenario "$SCENARIO" --mode auto --verbose "$@" 2>&1 | tee "$LOG"
rc="${PIPESTATUS[0]}"

echo
echo "════════════════════════════════════════════════════════════"
echo " RESULT (authoritative — from the manifest, NOT the 'Outcome:' line)"
echo "════════════════════════════════════════════════════════════"
# The runner's stdout `Outcome: success` does NOT reflect journal-assert criterion failures, so it is
# unreliable. Delegate to `verdict`, which reads the manifest's per-step criterionResults — the real
# pass/fail. Its exit code (0 = genuine pass) becomes this script's signal.
newest="$("$SCRIPT_DIR/sandbox" latest 2>/dev/null || true)"
verdict_rc=0
if [ -n "$newest" ]; then
  "$SCRIPT_DIR/verdict" --sandbox "$newest" | sed 's/^/  /' || true
  "$SCRIPT_DIR/verdict" --sandbox "$newest" >/dev/null 2>&1 || verdict_rc=1
else
  echo "  (no sandbox found — the run may have failed before deploying one; see the log above)"
  verdict_rc=1
fi

echo
if [ -n "$newest" ]; then
  echo "  sandbox: $newest"
  echo
  echo "  Next — read the real evidence:"
  echo "    $SCRIPT_DIR/verdict                         # authoritative per-step pass/fail (manifest)"
  echo "    $SCRIPT_DIR/journal tail 30                 # ordered event sequence"
  echo "    $SCRIPT_DIR/journal errors                  # journal events with an error/rejected payload"
  echo "    $SCRIPT_DIR/journal delegate                # session.delegate.* events (if a delegate ran)"
  echo "    $SCRIPT_DIR/daemon-log errors               # daemon crashes/fatals (NOT in the journal)"
  echo "    $SCRIPT_DIR/delegate-inspect                # brief.json + return.json (decision/paths_touched)"
fi
rm -f "$before"
# Exit non-zero if the manifest verdict failed, even when the runner printed 'Outcome: success'.
[ "$verdict_rc" -eq 0 ] && [ "$rc" -eq 0 ] && exit 0
exit 1
